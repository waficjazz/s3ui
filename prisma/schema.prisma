// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// RBAC Groups - Standalone model
// Represents user groups with optional admin privileges
model RbacGroup {
  id        Int    @id @default(autoincrement())
  
  // Group name (e.g., "is-dev-ops", "admin-group")
  groupName String @unique
  
  // Admin flag - whether this group has admin privileges
  isAdmin   Boolean @default(false)
  
  // Many-to-many relationship to rules via join table
  rules     RuleGroup[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  
  // Index for fast group lookups
  @@index([groupName], name: "idx_group_name")
  
  @@map("rbac_groups")
}

// RBAC Access Rules
// Stores unique access rules with associated groups via many-to-many relationship
model RbacAccessRule {
  id                Int       @id @default(autoincrement())
  
  // Bucket and path identifier
  bucketName        String    // e.g., "my-bucket"
  path              String?   // e.g., "/folder1" or NULL for bucket root
  
  // Access level
  accessType        AccessType @default(READ)
  
  // Include subfolders flag
  // e.g., path="/folder1" + includeSubfolders=true means access to /folder1/*
  includeSubfolders Boolean    @default(true)
  
  // Many-to-many relationship to groups via join table
  groups            RuleGroup[]
  
  // Metadata
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt
  
  // Audit logs
  auditLogs         RbacAuditLog[]
  
  // Unique constraint: same bucket/path/accessType combination appears only once
  @@unique([bucketName, path, accessType], name: "unique_bucket_path_access")
  
  // Indexes for fast lookups
  @@index([bucketName, path], name: "idx_bucket_path")
  
  @@map("rbac_access_rules")
}

// Join table for many-to-many relationship between rules and groups
model RuleGroup {
  id        Int    @id @default(autoincrement())
  
  // Foreign keys
  ruleId    Int
  groupId   Int
  
  // Relations
  rule      RbacAccessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  group     RbacGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  // Unique constraint: same group appears only once per rule
  @@unique([ruleId, groupId], name: "unique_rule_group")
  
  // Indexes for fast lookups
  @@index([ruleId], name: "idx_rule_id")
  @@index([groupId], name: "idx_group_id")
  
  @@map("rule_groups")
}

// Audit Log for RBAC changes
// Tracks who made what changes and when
model RbacAuditLog {
  id            Int              @id @default(autoincrement())
  
  action        String           // 'CREATE', 'UPDATE', 'DELETE'
  
  // Reference to the rule that was changed
  ruleId        Int?
  rule          RbacAccessRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  
  bucketName    String
  path          String?
  accessType    AccessType
  groupNames    String           // JSON array as string of affected groups
  
  // Who made the change
  changedBy     String
  
  // Old and new values for auditing
  oldValues     String?          // JSON stored as string
  newValues     String?          // JSON stored as string
  
  createdAt     DateTime         @default(now())
  
  @@index([createdAt], name: "idx_audit_created_at")
  @@index([ruleId], name: "idx_audit_rule_id")
  
  @@map("rbac_audit_log")
}

// Enum for access types
enum AccessType {
  READ
  WRITE
}
